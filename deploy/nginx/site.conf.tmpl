# Host nginx for __DOMAIN__. Cloudflare (proxied) -> this box :443 only.
# Rate-limit zones live in conf.d/webrdp-limits.conf.

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    ssl_reject_handshake on;   # unknown SNI / bare-IP scans get no certificate
}

server {
    listen 443 ssl http2;            # nginx 1.24 (Ubuntu 24.04) syntax
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:webrdp_ssl:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    client_max_body_size 64k;
    client_body_timeout 15s;
    client_header_timeout 15s;

    # Only Cloudflare may talk to the origin (ufw enforces it too).
    if ($webrdp_from_cf = 0) { return 444; }

    location = /api/v1/auth/login {
        limit_req zone=webrdp_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:18080;
        include /etc/nginx/snippets/webrdp-proxy.conf;
    }

    location = /api/v1/tunnel {
        limit_req zone=webrdp_api burst=10 nodelay;
        proxy_pass http://127.0.0.1:18080;
        include /etc/nginx/snippets/webrdp-proxy.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        limit_req zone=webrdp_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:18080;
        include /etc/nginx/snippets/webrdp-proxy.conf;
    }

    location = /healthz { return 404; }

    # Prometheus metrics: the API enforces session + admin role (RBAC).
    location = /metrics {
        limit_req zone=webrdp_api burst=5 nodelay;
        proxy_pass http://127.0.0.1:18080;
        include /etc/nginx/snippets/webrdp-proxy.conf;
    }

    location / {
        limit_req zone=webrdp_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:18081;
        include /etc/nginx/snippets/webrdp-proxy.conf;
    }
}
