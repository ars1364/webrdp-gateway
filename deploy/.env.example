# Copy to /opt/webrdp/.env (chmod 600). Generate each secret with:
#   openssl rand -base64 32
POSTGRES_SUPERUSER_PASSWORD=change-me
APP_DB_PASSWORD=change-me
APP_KEK=change-me-base64-32-bytes
APP_KEK_ID=1
# During a KEK rotation only (see docs/SECURITY.md):
# APP_KEK_PREVIOUS=
# APP_KEK_PREVIOUS_ID=
ALLOWED_ORIGIN=https://rdp.example.com
ALLOWED_HOSTS=rdp.example.com
IMAGE_TAG=latest
ALLOW_PRIVATE_TARGETS=false
SESSION_TTL=12h
MAX_TUNNELS=20
MAX_TUNNELS_PER_USER=5
MAX_TUNNEL_DURATION=8h
AUDIT_RETENTION_DAYS=180
FEATURE_CLIPBOARD=true
# Per-direction override (default: FEATURE_CLIPBOARD). Upload = local → remote.
# FEATURE_CLIPBOARD_UPLOAD=true
# FEATURE_CLIPBOARD_DOWNLOAD=true
FEATURE_FILE_TRANSFER=false
# Per-direction override (default: FEATURE_FILE_TRANSFER).
# FEATURE_FILE_UPLOAD=true
# FEATURE_FILE_DOWNLOAD=true
MAX_DRIVE_MB=1024
